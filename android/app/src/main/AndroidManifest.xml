<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The game list is downloaded from GitHub, and the ROMs along with it. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      A TV app that also installs on a phone or a tablet: every TV-specific
      feature is optional, so the same APK is offered by the TV launcher and by
      the ordinary one. There is no touch UI to declare, either.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:banner="@drawable/app_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.NesTv">

        <!--
          `landscape`: the picture is 256x240 and the TV is horizontal by
          definition. `configChanges`: rotating or docking must not throw the
          console away — the machine lives on its own thread and survives the
          configuration change.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- What actually puts the app on the Android TV home screen. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
